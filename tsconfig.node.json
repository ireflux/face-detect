{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    "moduleDetection": "force",
    "verbatimModuleSyntax": true
  },
  "include": ["vite.config.ts"]
}
